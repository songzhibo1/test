+#ifdef SCI_HE
+static inline intType field_mul_local(intType x, intType y) {
+  const uint64_t p = static_cast<uint64_t>(prime_mod);
+  const uint64_t xm = static_cast<uint64_t>(x) % p;
+  const uint64_t ym = static_cast<uint64_t>(y) % p;
+  const unsigned __int128 prod =
+      static_cast<unsigned __int128>(xm) * static_cast<unsigned __int128>(ym);
+  return static_cast<intType>(static_cast<uint64_t>(prod % p));
+}
+
+struct BeaverTriplePoolField {
+  bool enabled = false;
+  int32_t pool_size = 0;
+  int32_t cursor = 0;
+  uint64_t total_used = 0;
+  uint64_t refill_count = 0;
+  uint64_t online_fallback_count = 0;
+  std::vector<intType> a;
