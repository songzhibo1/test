+};
+
+static BeaverTriplePoolField he_beaver_pool_field;
+
+static int32_t get_he_beaver_pool_size() {
+  const char *v = std::getenv("SCI_HE_BEAVER_POOL");
+  if (v == nullptr) {
+    return 65536;
+  }
+  const long parsed = std::strtol(v, nullptr, 10);
+  if (parsed <= 0) {
+    return 0;
+  }
+  const long capped = std::min<long>(parsed, 1 << 20);
+  return static_cast<int32_t>(capped);
+}
+
+static void field_open_to_all(int32_t size, const intType *share,
+                              intType *opened) {
+  std::vector<intType> other((size_t)size, 0);
+  if (party == SERVER) {
+    io->send_data(share, sizeof(intType) * size);
+    io->recv_data(other.data(), sizeof(intType) * size);
+  } else {
+    io->recv_data(other.data(), sizeof(intType) * size);
+    io->send_data(share, sizeof(intType) * size);
+  }
+  for (int i = 0; i < size; ++i) {
+    opened[i] =
+        sci::neg_mod((int64_t)share[i] + (int64_t)other[(size_t)i],
+                     (int64_t)prime_mod);
+  }
+}
+
+static void he_asymmetric_field_mul(int32_t size, const intType *bob_input_share,
+                                    const intType *alice_multiplier_share,
+                                    intType *out_share) {
+  assert(he_prod != nullptr && "he_prod must be initialized for SCI_HE");
+  std::vector<uint64_t> in_vec((size_t)size, 0);
+  std::vector<uint64_t> mult_vec((size_t)size, 0);
+  std::vector<uint64_t> out_vec((size_t)size, 0);
+  const uint64_t p = static_cast<uint64_t>(prime_mod);
+
+  for (int i = 0; i < size; ++i) {
+    in_vec[(size_t)i] = static_cast<uint64_t>(bob_input_share[i]) % p;
+    mult_vec[(size_t)i] = static_cast<uint64_t>(alice_multiplier_share[i]) % p;
+  }
+  he_prod->elemwise_product(size, in_vec, mult_vec, out_vec, false, false);
+  for (int i = 0; i < size; ++i) {
+    out_share[i] = static_cast<intType>(out_vec[(size_t)i] % p);
+  }
+}
+
+static void generate_online_beaver_triple_field(int32_t size, intType *a_share,
+                                                intType *b_share,
+                                                intType *c_share) {
+  std::vector<intType> a_alice((size_t)size, 0), b_alice((size_t)size, 0);
+  std::vector<intType> a_bob((size_t)size, 0), b_bob((size_t)size, 0);
+  if (party == SERVER) {
+    prg128Instance->random_mod_p<uint64_t>((uint64_t *)a_alice.data(), size,
+                                           prime_mod);
+    prg128Instance->random_mod_p<uint64_t>((uint64_t *)b_alice.data(), size,
+                                           prime_mod);
+    memcpy(a_share, a_alice.data(), sizeof(intType) * size);
+    memcpy(b_share, b_alice.data(), sizeof(intType) * size);
+  } else {
+    prg128Instance->random_mod_p<uint64_t>((uint64_t *)a_bob.data(), size,
+                                           prime_mod);
+    prg128Instance->random_mod_p<uint64_t>((uint64_t *)b_bob.data(), size,
+                                           prime_mod);
+    memcpy(a_share, a_bob.data(), sizeof(intType) * size);
+    memcpy(b_share, b_bob.data(), sizeof(intType) * size);
+  }
+
+  std::vector<intType> cross_ab((size_t)size, 0);
+  std::vector<intType> cross_ba((size_t)size, 0);
+  he_asymmetric_field_mul(size, b_bob.data(), a_alice.data(), cross_ab.data());
+  he_asymmetric_field_mul(size, a_bob.data(), b_alice.data(), cross_ba.data());
+
+  for (int i = 0; i < size; ++i) {
+    intType local_term = 0;
+    if (party == SERVER) {
+      local_term = field_mul_local(a_alice[(size_t)i], b_alice[(size_t)i]);
+    } else {
+      local_term = field_mul_local(a_bob[(size_t)i], b_bob[(size_t)i]);
+    }
+    c_share[i] =
+        SecretAdd(SecretAdd(cross_ab[(size_t)i], cross_ba[(size_t)i]),
+                  local_term);
+  }
+}
+
+static void refill_he_beaver_pool_field() {
+  if (!he_beaver_pool_field.enabled || he_beaver_pool_field.pool_size <= 0) {
+    return;
+  }
+  he_beaver_pool_field.refill_count++;
+  he_beaver_refill_count++;
+  he_beaver_pool_field.cursor = 0;
+  he_beaver_pool_field.a.assign((size_t)he_beaver_pool_field.pool_size, 0);
+  he_beaver_pool_field.b.assign((size_t)he_beaver_pool_field.pool_size, 0);
+  he_beaver_pool_field.c.assign((size_t)he_beaver_pool_field.pool_size, 0);
+  generate_online_beaver_triple_field(
+      he_beaver_pool_field.pool_size, he_beaver_pool_field.a.data(),
+      he_beaver_pool_field.b.data(), he_beaver_pool_field.c.data());
+}
+
+static void fetch_beaver_triple_field(int32_t size, intType *a_share,
+                                      intType *b_share, intType *c_share) {
+  he_beaver_pool_field.total_used += static_cast<uint64_t>(size);
+  he_beaver_total_used += static_cast<uint64_t>(size);
+  if (he_beaver_pool_field.enabled && he_beaver_pool_field.pool_size >= size &&
+      he_beaver_pool_field.pool_size > 0) {
+    const int32_t remain =
+        he_beaver_pool_field.pool_size - he_beaver_pool_field.cursor;
+    if (remain < size) {
+      refill_he_beaver_pool_field();
+    }
+    const size_t off = (size_t)he_beaver_pool_field.cursor;
+    std::memcpy(a_share, he_beaver_pool_field.a.data() + off,
+                sizeof(intType) * size);
+    std::memcpy(b_share, he_beaver_pool_field.b.data() + off,
+                sizeof(intType) * size);
+    std::memcpy(c_share, he_beaver_pool_field.c.data() + off,
+                sizeof(intType) * size);
+    he_beaver_pool_field.cursor += size;
+    return;
+  }
+  he_beaver_pool_field.online_fallback_count++;
+  he_beaver_online_fallback_count++;
+  generate_online_beaver_triple_field(size, a_share, b_share, c_share);
+}
+
+static void init_he_beaver_pool_field_offline() {
+  he_beaver_pool_field.pool_size = get_he_beaver_pool_size();
+  he_beaver_pool_size_last = he_beaver_pool_field.pool_size;
+  he_beaver_pool_field.enabled = (he_beaver_pool_field.pool_size > 0);
+  he_beaver_pool_field.cursor = 0;
+  he_beaver_pool_field.total_used = 0;
+  he_beaver_pool_field.refill_count = 0;
+  he_beaver_pool_field.online_fallback_count = 0;
+  he_beaver_total_used = 0;
+  he_beaver_refill_count = 0;
+  he_beaver_online_fallback_count = 0;
+  if (he_beaver_pool_field.enabled) {
+    refill_he_beaver_pool_field();
+    if (party == CLIENT) {
+      std::cout << "[he-beaver] offline pool initialized size="
+                << he_beaver_pool_field.pool_size << std::endl;
+    }
+  } else if (party == CLIENT) {
