+
+static void elemwise_secret_shared_vector_mult_field_beaver(
+    int32_t size, intType *inArr, intType *multArrVec, intType *outputArr) {
+  std::vector<intType> a_share((size_t)size, 0), b_share((size_t)size, 0),
+      c_share((size_t)size, 0);
+  std::vector<intType> d_share((size_t)size, 0), e_share((size_t)size, 0);
+  std::vector<intType> d_open((size_t)size, 0), e_open((size_t)size, 0);
+
+  fetch_beaver_triple_field(size, a_share.data(), b_share.data(),
+                            c_share.data());
+
+  for (int i = 0; i < size; ++i) {
+    d_share[(size_t)i] = SecretSub(inArr[i], a_share[(size_t)i]);
+    e_share[(size_t)i] = SecretSub(multArrVec[i], b_share[(size_t)i]);
+  }
+
+  field_open_to_all(size, d_share.data(), d_open.data());
+  field_open_to_all(size, e_share.data(), e_open.data());
+
+  for (int i = 0; i < size; ++i) {
+    intType out_i = c_share[(size_t)i];
+    out_i = SecretAdd(out_i,
+                      field_mul_local(d_open[(size_t)i], b_share[(size_t)i]));
+    out_i = SecretAdd(out_i,
+                      field_mul_local(e_open[(size_t)i], a_share[(size_t)i]));
+    if (party == SERVER) {
+      out_i = SecretAdd(
+          out_i, field_mul_local(d_open[(size_t)i], e_open[(size_t)i]));
+    }
+    outputArr[i] = out_i;
+  }
+}
